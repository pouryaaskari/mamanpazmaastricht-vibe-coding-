PORT=3000
ADMIN_USERNAME=staff@mamanpaz.nl
ADMIN_PASSWORD=replace-with-a-long-random-password
# Set to 1 only when the app runs behind one trusted HTTPS reverse proxy.
TRUST_PROXY=0
RESTAURANT_EMAIL=mamanpazmaastricht@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=mamanpazmaastricht@gmail.com
SMTP_APP_PASSWORD=use-a-Google-App-Password-not-your-normal-password
MAIL_FROM=mamanpazmaastricht@gmail.com
# Set these to paths on the host's persistent volume in production.
DB_PATH=./mamanpaz.sqlite
UPLOAD_DIR=./uploads
# Ordering test mode is off by default and is always disabled when NODE_ENV=production.
ORDER_TEST_MODE=false
# Used only in local test mode; always separate from DB_PATH.
ORDER_TEST_DB_PATH=./mamanpaz-test.sqlite
# Normal collection preparation lead time (minutes; default 30, max 180).
ORDER_COLLECTION_PREP_MINUTES=30
# Optional test-mode collection preparation lead time (minutes; default 15, max 180).
ORDER_TEST_COLLECTION_LEAD_MINUTES=15
